# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# NYXORA_INVITE_DOMAIN: Registered HTTPS domain configured with .well-known/assetlinks.json for Android App Links.
# NYXORA_INVITE_DOMAIN=nyxora.app

# NYXORA_CONNECT_WSS_ENDPOINT: Reachable production WebSocket Secure (wss://) relay endpoint for cross-network room sync.
# NYXORA_CONNECT_WSS_ENDPOINT=wss://n-browser.onrender.com/nyxora

# NYXORA_GITHUB_REPO: GitHub repository (owner/repo) used to check for latest APK releases.
NYXORA_GITHUB_REPO=Sudhamoy-X/N-browser-

# NYXORA_GITHUB_RELEASE_API_URL: Optional full GitHub Releases API endpoint override.
NYXORA_GITHUB_RELEASE_API_URL=https://api.github.com/repos/Sudhamoy-X/N-browser-/releases/tags/nyxora-debug-latest

# NYXORA_WEBRTC_STUN_URLS: Comma-separated STUN server URLs for WebRTC NAT traversal (Google STUN default).
NYXORA_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# NYXORA_WEBRTC_TURN_URLS: Optional comma-separated TURN/TURNS server URLs for relay NAT traversal (set via Secrets panel or CI secrets when TURN is configured).
NYXORA_WEBRTC_TURN_URLS=UNCONFIGURED

# NYXORA_WEBRTC_TURN_USERNAME: Optional TURN username (set via Secrets panel or CI variables/secrets when TURN is configured).
NYXORA_WEBRTC_TURN_USERNAME=UNCONFIGURED

# NYXORA_WEBRTC_TURN_CREDENTIAL: Optional TURN password/credential (set via Secrets panel or CI secrets when TURN is configured; never hardcode production credentials).
NYXORA_WEBRTC_TURN_CREDENTIAL=UNCONFIGURED


